# Werte über `supabase secrets set <NAME>=<wert> --project-ref <ref>` setzen
# (Deno-Edge-Functions lesen sie zur Laufzeit über Deno.env.get) oder lokal
# über `supabase functions serve --env-file .env` — nie echte Werte in
# dieses Beispiel oder ins Repo eintragen.

# Pflicht für jeden Datenbankzugriff aus einer Edge Function heraus.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# KI-Provider-Fallback-Kette (_shared/ai/router.ts) — mindestens einer
# davon muss gesetzt sein, sonst schlägt hasAnyAiProviderConfigured() fehl.
# Reihenfolge in router.ts: Cerebras -> NVIDIA -> Gemini.
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Separater Key für die KI-gestützte Quellensuche (discover-sources),
# unabhängig von GEMINI_API_KEY.
GEMINI_SEARCH_API_KEY=

# Websuche für Entity-Anreicherung/-Recherche (discover-sources,
# resolve-entity-candidates, enrich-event-references — teils inzwischen auf
# die kostenlose DuckDuckGo-Suche umgestellt, siehe dortige Kommentare;
# Tavily bleibt für die verbleibenden Aufrufer nötig).
TAVILY_API_KEY=

# Zusätzlich pro Quelle (nicht hier, sondern als eigenes Supabase-Secret):
# manche 'api'-Quellen (z.B. BayernCloud Tourismus) brauchen ein Bearer-
# Token, dessen SECRET-NAME in sources.config.authHeaderEnvVar steht, nicht
# der Token selbst — siehe ingest-source/core.ts.
