    "E-Mail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        }
      }
    },
    "E-Mail bestätigen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Email"
          }
        }
      }
    },
    "E-Mail wurde versendet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email Sent"
          }
        }
      }
    },
    "E-Mail-Adresse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email Address"
          }
        }
      }
    },
    "E-Mail-Adressen und Telefonnummern werden auf deinem iPhone verschlüsselt (SHA-256) und nur so abgeglichen. Klangradar speichert deine Kontakte nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email addresses and phone numbers are encrypted (SHA-256) on your iPhone and only matched that way. Klangradar doesn't store your contacts."
          }
        }
