# Kopieren nach .env.local und mit echten Werten aus dem Supabase-Projekt füllen.
# .env.local ist in .gitignore (Next.js-Standard) und wird nicht committet.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (kein NEXT_PUBLIC_-Prefix — landet NICHT im Client-Bundle).
# Muss mit dem Supabase-Vault-Secret "internal_function_secret" und dem
# Edge-Function-Secret INTERNAL_FUNCTION_SECRET übereinstimmen, siehe
# backend/supabase/migrations/20261029000002_internal_function_secret_for_cron.sql
INTERNAL_FUNCTION_SECRET=your-internal-function-secret
